# Copie ce fichier vers .env puis adapte-le selon ton environnement.

# Port et interface d'ecoute du bridge
PORT=9999
HOST=0.0.0.0

# Token requis pour TOUTES les requetes (sauf /health).
# En production, choisis une longue chaine aleatoire.
BRIDGE_TOKEN=change-me-please

# Mode mock : aucun socket Docker requis (ideal pour dev/test sur Windows).
# Passe a false pour piloter ton vrai Docker.
MOCK_DOCKER=true

# Chemin du socket Docker en mode reel (Linux uniquement).
DOCKER_SOCKET=/var/run/docker.sock

# Annuaire des services web affiches dans l'onglet Services de l'app.
# (defaut : services.yaml a cote du bridge ; voir services.yaml.example)
# SERVICES_FILE=/chemin/vers/services.yaml

# Racine de l'hote montee dans le conteneur (compose.yaml : /:/hostfs:ro).
# Permet les stats disques de la machine via statfs. Laisser vide hors Docker.
# HOST_FS_ROOT=/hostfs

# Port du serveur SSH de l'hote, utilise par le terminal de l'app.
# SSH_PORT=22