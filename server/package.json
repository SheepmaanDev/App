{
  "name": "homelab-bridge",
  "version": "0.1.0",
  "description": "Pont d'acces securise pour piloter les services Docker de votre homelab (API REST + WebSocket).",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.0",
    "dockerode": "^5.0.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "ssh2": "^1.17.0",
    "systeminformation": "^5.33.9",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.1",
    "@types/node": "^26.4.0",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
